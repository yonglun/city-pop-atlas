# Exact origin visible to visitors; no trailing slash. TLS terminates at your existing HTTPS reverse proxy.
# Existing production installation: keep https://city-pop.softmatrix.io unchanged.
# HTTPS public origins enable canonical reading pages and sitemap; local HTTP stays noindex.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
RELEASE_TAG=20261006-performance-v38
CITYPOP_DATA_DIR=./runtime
CITYPOP_SECRETS_DIR=./secrets
# Optional authenticated administration, SSH tunnel only. No password ships with this package.
ADMIN_ENABLED=false
ADMIN_ORIGIN=http://127.0.0.1:8081
ADMIN_HOST_PORT=8081
CITYPOP_BACKUP_DIR=./backups
CITYPOP_UID=1000
CITYPOP_GID=1000

# Optional audience analytics; blank by default, loaded only after visitor opt-in.
# Public integration identifiers only. Never insert API keys here.
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
